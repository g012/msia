# Documentation only. Rails does not automatically load .env files.
# Export variables in your shell or load them with your deployment secret manager.
APP_URL=http://localhost:3000
# Development uses local peer-authenticated msia_development / msia_test by default.
# DATABASE_URL=postgresql://msia:URL_ENCODED_PASSWORD@msia-db:5432/msia_production
# Production only (generate with bin/rails secret):
SECRET_KEY_BASE=
ADMIN_USERNAME=
# At least 24 random characters in production:
ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=MSIA <bonjour@your-domain.example>
GOOD_JOB_ENABLE_CRON=true
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_REGISTRATION=
PUBLICATION_DIRECTOR=
HOSTING_PROVIDER=
PUBLIC_CONTACT=
PRIVACY_CONTACT=
# Name / location of hosting and email providers, purpose, any transfer safeguards:
PROCESSOR_DISCLOSURE=
POSTGRES_PASSWORD=
KAMAL_REGISTRY_PASSWORD=
