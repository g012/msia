<section class="shell narrow section subscription-message"><span class="thank-you-icon">✳︎</span><% if @signup.confirmed_at? && !@signup.unsubscribed_at? %><h1><%= t('waitlist.confirmed_title') %></h1><p><%= t('waitlist.confirmed_body') %></p><%= link_to t('mail.preferences'), preferences_path(token: @signup.management_token), class: 'button' %><% elsif @signup.unsubscribed_at? %><h1><%= t('waitlist.unsubscribed_title') %></h1><% else %><h1><%= t('waitlist.confirm_title') %></h1><p><%= t('waitlist.confirm_body') %></p><%= button_to t('waitlist.confirm_button'), confirmation_path(token: params[:token]), class: 'button' %><% end %></section>
