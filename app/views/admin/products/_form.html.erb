<%= form_with model: [:admin, @product], class: 'admin-form' do |f| %>
<%= render 'shared/errors', record: @product %>
<fieldset><legend>Identity & presentation</legend><div class="admin-form-grid"><% %w[name slug sku net_weight pack_size manufacturer country_of_origin shelf_life official_source_url dietary_evidence].each do |field| %><div class="form-field"><%= f.label field %><%= f.text_field field %></div><% end %><div class="form-field"><%= f.label :brand_id %><%= f.collection_select :brand_id, Brand.order(:name), :id, :name %></div><div class="form-field"><%= f.label :supplier_id %><%= f.collection_select :supplier_id, Supplier.order(:name), :id, :name, include_blank: 'Unknown' %></div><div class="form-field"><%= f.label :illustration %><%= f.select :illustration, %w[noodles coffee tea snacks pantry] %></div><div class="form-field"><%= f.label :photo, 'Own / authorised image only (JPEG, PNG or WebP, max 8 MB)' %><%= f.file_field :photo, accept: 'image/jpeg,image/png,image/webp' %><%= image_tag @product.photo, width: 120, alt: 'Current product photo' if @product.photo.attached? %></div></div><label class="check-option"><%= f.check_box :featured %> Featured on homepage</label><fieldset><legend>Categories</legend><%= f.collection_check_boxes :category_ids, Category.order(:id), :id, :name_en do |box| %><label class="check-option"><%= box.check_box %><%= box.text %></label><% end %></fieldset></fieldset>
<fieldset><legend>Research & regulatory status</legend><p class="admin-note">Unknown is a real state. Only select a dietary attribute with product-specific evidence. “Available” changes the public label; it does not enable transactions. Uploading an image requires appropriate rights.</p><div class="admin-form-grid"><% %w[vegetarian contains_animal_products spicy].each do |field| %><div class="form-field"><%= f.label field %><%= f.select field, [['Unknown', ''], ['Confirmed yes', true], ['Confirmed no', false]] %></div><% end %><% { halal_status: Product.halal_statuses.keys, eu_compliance_status: Product.eu_compliance_statuses.keys, launch_status: Product.launch_statuses.keys }.each do |field,options| %><div class="form-field"><%= f.label field %><%= f.select field, options %></div><% end %></div><label class="check-option"><%= f.check_box :selected_for_first_import %> Selected for first import (internal planning only)</label></fieldset>
<fieldset><legend>Verified manufacturer text · original language</legend><p class="tiny muted">Record only product-specific published facts. Leave missing information blank.</p><div class="admin-form-grid"><% %w[ingredients allergens preparation nutrition].each do |field| %><div class="form-field"><%= f.label field %><%= f.text_area field, rows: 5 %></div><% end %></div></fieldset>
<%= f.fields_for :product_translations do |tr| %><fieldset><legend>Translation · <%= tr.object.locale&.upcase %></legend><%= tr.hidden_field :locale %><div class="form-field"><%= tr.label :name %><%= tr.text_field :name, required: true %></div><div class="form-field"><%= tr.label :short_description %><%= tr.text_area :short_description, rows: 2 %></div><div class="admin-form-grid"><% %w[description origin ingredients allergens preparation nutrition].each do |field| %><div class="form-field"><%= tr.label field %><%= tr.text_area field, rows: 4 %></div><% end %></div><label class="check-option"><%= tr.check_box :regulated_reviewed %> Food information translation reviewed by a competent person</label><p class="tiny muted">Editing ingredients, allergens, nutrition or preparation resets review. Save the content first, then explicitly approve in a second save.</p></fieldset><% end %>
<fieldset><legend>Sources & image provenance</legend><%= f.fields_for :product_sources do |src| %><div class="admin-form-grid"><% %w[source_name url image_url].each do |field| %><div class="form-field"><%= src.label field %><%= src.text_field field %></div><% end %><div class="form-field"><%= src.label :image_rights_status %><%= src.select :image_rights_status, %w[permission_required permitted original] %></div><div class="form-field"><%= src.label :confirmed_facts %><%= src.text_area :confirmed_facts %></div><div class="form-field"><%= src.label :unknown_facts %><%= src.text_area :unknown_facts %></div></div><label class="check-option"><%= src.check_box :_destroy %> Remove this source</label><hr><% end %></fieldset>
<%= f.submit 'Save product', class: 'button' %> <%= link_to 'Back to products', admin_products_path, class: 'text-link' %>
<% end %>
