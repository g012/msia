<div class="admin-toolbar"><h1>Product research catalogue</h1><%= link_to '+ New product', new_admin_product_path, class: 'button' %></div><div class="table-scroll"><table><thead><tr><th>Product</th><th>Brand</th><th>Launch</th><th>EU status</th><th>Selected</th><th></th></tr></thead><tbody><% @products.each do |product| %><tr><td><%= link_to product.name, edit_admin_product_path(product) %></td><td><%= product.brand.name %></td><td><%= product.launch_status %></td><td><%= product.eu_compliance_status %></td><td><%= product.selected_for_first_import? ? 'Yes' : '—' %></td><td><%= link_to 'View ↗', product_path(product) unless product.launch_rejected? %></td></tr><% end %></tbody></table></div>
