<div class="admin-toolbar"><h1>Waitlist</h1><%= link_to 'Export all to CSV', export_admin_waitlist_signups_path(format: :csv), class: 'button', data: { turbo: false } %></div><p class="admin-note">Latest 200 records shown. CSV contains all records and consent / unsubscribe status. Use only confirmed, active subscribers for launch emails. Treat exports as personal data and delete them when no longer needed.</p><div class="table-scroll"><table><thead><tr><th>Email</th><th>Country / postcode</th><th>Confirmation</th><th>Consent</th><th>Source</th><th>Import wish</th><th>Products / categories</th><th>Erase</th></tr></thead><tbody><% @signups.each do |signup| %><tr><td><%= signup.email %><br><%= signup.first_name %></td><td><%= signup.country %><br><%= signup.postcode %></td><td><%= signup.unsubscribed_at? ? 'Unsubscribed' : signup.confirmed_at&.iso8601 || 'Pending email confirmation' %></td><td><%= signup.consented_at.iso8601 %><br><%= signup.consent_version %></td><td><%= signup.utm_source.presence || 'Direct' %></td><td><%= signup.import_wish %></td><td><%= signup.products.map(&:name).join(', ') %><br><%= signup.categories.map(&:name_en).join(', ') %></td><td><%= button_to 'Erase', admin_waitlist_signup_path(signup), method: :delete, class: 'danger-button', data: { turbo_confirm: 'Permanently erase this person and preferences?' } %></td></tr><% end %></tbody></table></div>
