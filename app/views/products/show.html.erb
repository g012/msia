<% @title = @product.display_name + ' — MSIA'; @description = @product.translation&.short_description %>
<section class="shell product-detail">
  <%= link_to '← ' + t('common.back'), products_path, class: 'back-link' %>
  <div class="product-detail-grid"><div><div class="detail-visual product-image-<%= @product.illustration %>"><%= product_visual(@product, eager: true) %></div><p class="tiny muted"><%= t('common.illustration') unless @product.photo.attached? %></p></div>
    <div class="detail-copy"><p class="eyebrow"><%= @product.brand.name %> / <%= @product.categories.map(&:name).join(' · ') %></p><h1><%= @product.display_name %></h1><p class="detail-description"><%= @product.translation&.short_description %></p><p class="status-label"><span class="status-dot"></span><%= @product.launch_available? ? t('product.available_body') : t('common.not_for_sale') %></p><%= interest_button(@product, class_name: 'button detail-interest') %><p class="tiny muted"><%= t('home.waitlist_small') %></p>
      <dl class="compact-facts"><% %w[pack_size net_weight].each do |field| %><div><dt><%= t("product.#{field}") %></dt><dd><%= @product.public_send(field).presence || t('common.unknown') %></dd></div><% end %></dl>
      <% if @product.vegetarian == true %><p class="dietary-note"><span class="tag"><%= t('product.vegetarian') %></span><%= t('product.dietary_note') %></p><% end %>
    </div>
  </div>
  <div class="detail-information"><div class="prose"><h2><%= t('product.description') %></h2><p><%= @product.translation&.description.presence || t('common.unknown') %></p><h2><%= t('product.origin') %></h2><p><%= @product.translation&.origin.presence || t('common.unknown') %></p>
    <% %w[ingredients allergens preparation nutrition].each do |field| %><section class="regulated-section"><h2><%= t("product.#{field}") %></h2><% translated = @product.translation&.public_send(field) %><% if translated.present? %><% unless @product.translation.regulated_reviewed? %><p class="review-notice"><%= t('product.unreviewed') %></p><% end %><p class="whitespace-pre-line"><%= translated %></p><% elsif @product.public_send(field).present? %><p class="tiny muted"><%= t('product.original') %></p><p class="whitespace-pre-line" lang="en"><%= @product.public_send(field) %></p><% else %><p class="muted"><%= t('common.unknown') %></p><% end %></section><% end %>
    <h2><%= t('product.sources') %></h2><% @product.product_sources.each do |source| %><p><%= link_to source.source_name + ' ↗', source.url, target: '_blank', rel: 'noopener noreferrer', class: 'text-link' %><br><span class="tiny muted"><%= source.checked_at&.to_date&.iso8601 %></span></p><% end %><p class="tiny"><%= t('product.source_unknowns') %></p>
  </div><aside class="research-panel"><p class="eyebrow"><%= t('product.facts') %></p><dl><% %w[manufacturer country_of_origin shelf_life].each do |field| %><dt><%= t("product.#{field}") %></dt><dd><%= @product.public_send(field).presence || t('common.unknown') %></dd><% end %><dt><%= t('product.halal') %></dt><dd><%= @product.halal_unknown? ? t('product.halal_unknown') : @product.halal_status %></dd><dt><%= t('product.status') %></dt><dd><%= t("product.eu_states.#{@product.eu_compliance_status}") %></dd></dl><h3><%= t('product.availability') %></h3><p><%= @product.launch_available? ? t('product.available_body') : t('product.availability_body') %></p></aside></div>
</section>
<%= render 'shared/waitlist_cta' %>
