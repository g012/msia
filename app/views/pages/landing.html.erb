<% @title = t("landing.#{@topic}.title") + ' — MSIA'; @description = t("landing.#{@topic}.intro") %>
<section class="shell editorial-landing section"><div class="editorial-copy"><p class="eyebrow"><%= t('landing_eyebrow') %></p><h1><%= t("landing.#{@topic}.title") %></h1><p class="lead"><%= t("landing.#{@topic}.intro") %></p><p><%= t("landing.#{@topic}.body") %></p><% if @topic == 'kopitiam' %><%= link_to t('common.source') + ' : Hock Kee ↗', 'https://www.hockkeegroup.com/our-story/', class: 'text-link', target: '_blank', rel: 'noopener noreferrer' %><% end %><p><%= link_to t('common.join') + ' ↗', new_waitlist_signup_path, class: 'button' %></p></div><%= image_tag @topic == 'kopitiam' ? 'coffee.svg' : 'noodles.svg', alt: '', width: 600, height: 480 %></section>
<section class="shell section"><div class="section-heading"><h2><%= t('home.collection_title') %></h2><%= link_to t('common.all_products') + ' ↗', products_path, class: 'text-link' %></div><div class="product-grid"><%= render partial: 'products/card', collection: @products, as: :product %></div></section>
<%= render 'shared/waitlist_cta' %>
