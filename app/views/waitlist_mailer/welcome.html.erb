<h1><%= t('mail.hello') %></h1><p><%= t('mail.body') %></p><p><%= link_to t('mail.confirm'), confirmation_url(locale: @signup.locale, token: @signup.confirmation_token) %></p><p><%= t('mail.expires') %></p><h2><%= t('mail.selected') %></h2><% if @signup.products.any? || @signup.categories.any? %><ul><% @signup.products.each do |product| %><li><%= product.translation(@signup.locale)&.name || product.name %></li><% end %><% @signup.categories.each do |category| %><li><%= category.name %></li><% end %></ul><% else %><p><%= t('mail.no_selection') %></p><% end %><p><%= t('mail.next') %></p><p><%= link_to t('mail.preferences'), preferences_url(locale: @signup.locale, token: @signup.management_token) %> · <%= link_to t('mail.unsubscribe'), unsubscribe_url(locale: @signup.locale, token: @signup.unsubscribe_token) %></p>
